{
  "operationName": "deleteCustomerById",
  "httpMethod": "DELETE",
  "path": "/customers/{id}",
  "description": "Mevcut memory-based customer yapısını kullanarak ID ile müşteri siler.",
  "requestSchema": {
    "type": "object",
    "pathParameters": {
      "id": {
        "type": "long",
        "required": true,
        "minimum": 1
      }
    }
  },
  "responseSchema": {
    "type": "none",
    "description": "Başarılı silme yanıtı body içermez."
  },
  "validationRules": [
    "id long olmalı.",
    "id 1 veya daha büyük olmalı."
  ],
  "expectedStatusCodes": [
    {
      "status": 204,
      "name": "NO_CONTENT",
      "description": "Müşteri başarıyla silindi."
    },
    {
      "status": 400,
      "name": "BAD_REQUEST",
      "description": "ID geçersiz."
    },
    {
      "status": 404,
      "name": "NOT_FOUND",
      "description": "Müşteri bulunamadı."
    }
  ],
  "businessRules": [
    {
      "id": "BR-01",
      "description": "Silme işlemi mevcut CustomerController, CustomerService ve memory storage kullanılarak uygulanmalı; yeni service, repository veya storage implementation oluşturulmamalı.",
      "mandatory": true,
      "parameters": {
        "componentsToReuse": [
          "CustomerController",
          "CustomerService"
        ],
        "storage": "existingMemoryStorage",
        "extensionAllowed": true,
        "mustNotCreate": [
          "customerService",
          "repository",
          "storageImplementation"
        ]
      }
    },
    {
      "id": "BR-02",
      "description": "Customer mevcutsa memory storage içinden silinmeli ve 204 NO_CONTENT dönmeli.",
      "mandatory": true,
      "parameters": {
        "lookupField": "id",
        "onFound": "DELETE",
        "successStatus": 204,
        "responseBody": false
      }
    },
    {
      "id": "BR-03",
      "description": "Customer bulunamazsa 404 NOT_FOUND dönmeli.",
      "mandatory": true,
      "parameters": {
        "onMissing": "NOT_FOUND",
        "failureStatus": 404
      }
    },
    {
      "id": "BR-04",
      "description": "Silinen customer daha sonra GET /customers/{id} ile istendiğinde 404 NOT_FOUND dönmeli.",
      "mandatory": true,
      "parameters": {
        "afterDelete": {
          "httpMethod": "GET",
          "path": "/customers/{id}",
          "expectedStatus": 404
        }
      }
    },
    {
      "id": "BR-05",
      "description": "Mevcut POST /customers davranışı korunmalı.",
      "mandatory": true,
      "parameters": {
        "httpMethod": "POST",
        "path": "/customers",
        "preserveExistingBehavior": true
      }
    },
    {
      "id": "BR-06",
      "description": "Mevcut duplicate-email kontrolü ve 409 CONFLICT davranışı korunmalı.",
      "mandatory": true,
      "parameters": {
        "httpMethod": "POST",
        "path": "/customers",
        "field": "email",
        "caseSensitive": false,
        "duplicateStatus": 409,
        "preserveExistingBehavior": true
      }
    },
    {
      "id": "BR-07",
      "description": "Mevcut GET /customers/{id} davranışı korunmalı.",
      "mandatory": true,
      "parameters": {
        "httpMethod": "GET",
        "path": "/customers/{id}",
        "preserveExistingBehavior": true
      }
    },
    {
      "id": "BR-08",
      "description": "Mevcut GET /hello davranışı korunmalı.",
      "mandatory": true,
      "parameters": {
        "httpMethod": "GET",
        "path": "/hello",
        "preserveExistingBehavior": true
      }
    }
  ],
  "persistenceRequired": false,
  "externalServiceRequired": false,
  "acceptanceCriteria": [
    {
      "id": "AC-01",
      "criterion": "Mevcut customer için DELETE /customers/{id} 204 NO_CONTENT dönmeli.",
      "mandatory": true,
      "preferredVerificationMethod": "AUTOMATED_TEST"
    },
    {
      "id": "AC-02",
      "criterion": "Geçersiz id için DELETE /customers/{id} 400 BAD_REQUEST dönmeli.",
      "mandatory": true,
      "preferredVerificationMethod": "AUTOMATED_TEST"
    },
    {
      "id": "AC-03",
      "criterion": "Bulunamayan customer için DELETE /customers/{id} 404 NOT_FOUND dönmeli.",
      "mandatory": true,
      "preferredVerificationMethod": "AUTOMATED_TEST"
    },
    {
      "id": "AC-04",
      "criterion": "Silinen customer daha sonra GET /customers/{id} ile istendiğinde 404 NOT_FOUND dönmeli.",
      "mandatory": true,
      "preferredVerificationMethod": "AUTOMATED_TEST"
    },
    {
      "id": "AC-05",
      "criterion": "Mevcut POST /customers davranışı çalışmaya devam etmeli.",
      "mandatory": true,
      "preferredVerificationMethod": "AUTOMATED_TEST"
    },
    {
      "id": "AC-06",
      "criterion": "Mevcut duplicate-email kontrolü ve 409 CONFLICT davranışı çalışmaya devam etmeli.",
      "mandatory": true,
      "preferredVerificationMethod": "AUTOMATED_TEST"
    },
    {
      "id": "AC-07",
      "criterion": "Mevcut GET /customers/{id} davranışı çalışmaya devam etmeli.",
      "mandatory": true,
      "preferredVerificationMethod": "AUTOMATED_TEST"
    },
    {
      "id": "AC-08",
      "criterion": "Mevcut GET /hello davranışı çalışmaya devam etmeli.",
      "mandatory": true,
      "preferredVerificationMethod": "AUTOMATED_TEST"
    },
    {
      "id": "AC-09",
      "criterion": "DELETE endpoint davranışı için testler eklenmeli veya mevcut testler uygun şekilde genişletilmeli.",
      "mandatory": true,
      "preferredVerificationMethod": "STATIC_INSPECTION"
    },
    {
      "id": "AC-10",
      "criterion": "./mvnw test başarılı olmalı.",
      "mandatory": true,
      "preferredVerificationMethod": "COMMAND"
    },
    {
      "id": "AC-11",
      "criterion": "./mvnw clean package başarılı olmalı.",
      "mandatory": true,
      "preferredVerificationMethod": "BUILD"
    }
  ]
}
