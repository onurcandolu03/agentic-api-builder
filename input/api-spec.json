{
  "operationName": "createCustomerWithUniqueEmail",
  "httpMethod": "POST",
  "path": "/customers",
  "description": "Benzersiz email adresi ile yeni müşteri oluşturur.",
  "requestSchema": {
    "type": "object",
    "fields": {
      "firstName": {
        "type": "string",
        "required": true,
        "minLength": 2
      },
      "lastName": {
        "type": "string",
        "required": true,
        "minLength": 2
      },
      "email": {
        "type": "string",
        "required": true,
        "format": "email"
      }
    }
  },
  "responseSchema": {
    "type": "object",
    "fields": {
      "id": {
        "type": "long"
      },
      "firstName": {
        "type": "string"
      },
      "lastName": {
        "type": "string"
      },
      "email": {
        "type": "string"
      }
    }
  },
  "validationRules": [
    "firstName boş olamaz ve en az 2 karakter olmalı.",
    "lastName boş olamaz ve en az 2 karakter olmalı.",
    "email boş olamaz ve geçerli email formatında olmalı."
  ],
  "expectedStatusCodes": [
    {
      "status": 201,
      "name": "CREATED",
      "description": "Müşteri başarıyla oluşturuldu."
    },
    {
      "status": 400,
      "name": "BAD_REQUEST",
      "description": "Request validation başarısız."
    },
    {
      "status": 409,
      "name": "CONFLICT",
      "description": "Aynı email adresine sahip müşteri zaten mevcut."
    }
  ],
  "businessRules": [
    {
      "id": "BR-01",
      "description": "Email adresi müşteri kayıtları arasında benzersiz olmalı.",
      "mandatory": true,
      "parameters": {
        "field": "email",
        "scope": "customerRecords",
        "failureStatus": 409
      }
    },
    {
      "id": "BR-02",
      "description": "Aynı email adresiyle ikinci müşteri oluşturulmamalı.",
      "mandatory": true,
      "parameters": {
        "operation": "createCustomer",
        "onDuplicate": "REJECT",
        "failureStatus": 409
      }
    },
    {
      "id": "BR-03",
      "description": "Duplicate email kontrolü mevcut CustomerService ve mevcut memory storage kullanılarak yapılmalı.",
      "mandatory": true,
      "parameters": {
        "service": "CustomerService",
        "storage": "existingMemoryStorage"
      }
    },
    {
      "id": "BR-04",
      "description": "Duplicate kontrolü case-insensitive olmalı.",
      "mandatory": true,
      "parameters": {
        "field": "email",
        "caseSensitive": false
      }
    },
    {
      "id": "BR-05",
      "description": "Duplicate email durumunda yeni ID üretilmemeli.",
      "mandatory": true,
      "parameters": {
        "consumeIdentifierOnFailure": false
      }
    },
    {
      "id": "BR-06",
      "description": "Duplicate email durumunda mevcut müşteri kaydı değiştirilmemeli.",
      "mandatory": true,
      "parameters": {
        "modifyExistingRecordOnFailure": false
      }
    },
    {
      "id": "BR-07",
      "description": "Yeni repository, yeni storage implementasyonu veya yeni customer service oluşturulmamalı.",
      "mandatory": true,
      "parameters": {
        "mustNotCreate": [
          "repository",
          "storageImplementation",
          "customerService"
        ]
      }
    },
    {
      "id": "BR-08",
      "description": "Mevcut GET /customers/{id} davranışı korunmalı.",
      "mandatory": true,
      "parameters": {
        "httpMethod": "GET",
        "path": "/customers/{id}",
        "preserveExistingBehavior": true
      }
    }
  ],
  "persistenceRequired": false,
  "externalServiceRequired": false,
  "acceptanceCriteria": [
    {
      "id": "AC-01",
      "criterion": "İlk geçerli POST /customers isteği 201 CREATED dönmeli.",
      "mandatory": true,
      "preferredVerificationMethod": "AUTOMATED_TEST"
    },
    {
      "id": "AC-02",
      "criterion": "Aynı email ile ikinci POST /customers isteği 409 CONFLICT dönmeli.",
      "mandatory": true,
      "preferredVerificationMethod": "AUTOMATED_TEST"
    },
    {
      "id": "AC-03",
      "criterion": "Email karşılaştırması case-insensitive olmalı.",
      "mandatory": true,
      "preferredVerificationMethod": "AUTOMATED_TEST"
    },
    {
      "id": "AC-04",
      "criterion": "Duplicate istekte yeni müşteri oluşturulmamalı.",
      "mandatory": true,
      "preferredVerificationMethod": "AUTOMATED_TEST"
    },
    {
      "id": "AC-05",
      "criterion": "Duplicate istekte yeni ID tüketilmemeli.",
      "mandatory": true,
      "preferredVerificationMethod": "AUTOMATED_TEST"
    },
    {
      "id": "AC-06",
      "criterion": "Validation hataları 400 BAD_REQUEST dönmeye devam etmeli.",
      "mandatory": true,
      "preferredVerificationMethod": "AUTOMATED_TEST"
    },
    {
      "id": "AC-07",
      "criterion": "Mevcut GET /customers/{id} çalışmaya devam etmeli.",
      "mandatory": true,
      "preferredVerificationMethod": "AUTOMATED_TEST"
    },
    {
      "id": "AC-08",
      "criterion": "Mevcut GET /hello çalışmaya devam etmeli.",
      "mandatory": true,
      "preferredVerificationMethod": "AUTOMATED_TEST"
    },
    {
      "id": "AC-09",
      "criterion": "Endpoint davranışı için testler eklenmeli.",
      "mandatory": true,
      "preferredVerificationMethod": "STATIC_INSPECTION"
    },
    {
      "id": "AC-10",
      "criterion": "./mvnw test başarılı olmalı.",
      "mandatory": true,
      "preferredVerificationMethod": "AUTOMATED_TEST"
    },
    {
      "id": "AC-11",
      "criterion": "./mvnw clean package başarılı olmalı.",
      "mandatory": true,
      "preferredVerificationMethod": "BUILD"
    }
  ]
}
